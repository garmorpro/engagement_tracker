# Copy this file to .env (in the directory one level above vendor/ — see
# includes/db.php for the exact expected location) and fill in real values.
# .env itself is gitignored and must never be committed.

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional. Set to "true" to show PHP errors/stack traces on-screen (local
# dev only). Any other value, or leaving it unset, keeps them off — which is
# required in production since on-screen errors can leak file paths and
# other internals to visitors.
APP_DEBUG=false

# Optional. Overrides the hardcoded production URL in path.php — useful for
# running this app locally or on a staging box. Only takes effect if
# something in the request has already loaded .env via Dotenv (which calls
# putenv() internally) before path.php runs; leave unset in production.
BASE_URL=
